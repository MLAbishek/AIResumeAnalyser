APP_ENV=development
LOG_LEVEL=INFO

DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
NORMALIZED_DATA_DIR=data/normalized
EVALUATION_DATA_DIR=data/evaluation

EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=

# LLM explanation generation (OpenRouter, OpenAI-compatible API).
# The LLM only generates natural-language explanation text for an
# already-computed deterministic screening result - it never affects
# scoring, eligibility, or the decision. Leave ENABLE_LLM_EXPLANATIONS
# unset/false to keep tests and any environment without a key
# network-call-free; screening works fully without it either way.
ENABLE_LLM_EXPLANATIONS=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=15

TOP_K=10
MIN_MATCH_SCORE=0.0

BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5

ENABLE_SEMANTIC_SEARCH=true
ENABLE_LLM_RERANKING=false

# Authentication
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Sign-In - the OAuth Web Client ID from Google Cloud Console
# (APIs & Services > Credentials). This is a public identifier, safe
# to expose to the frontend too - it must be the SAME value as
# frontend/.env's VITE_GOOGLE_CLIENT_ID. No client secret is needed:
# ID-token verification never uses one. Leave empty to disable
# Google Sign-In (password auth keeps working either way).
GOOGLE_CLIENT_ID=